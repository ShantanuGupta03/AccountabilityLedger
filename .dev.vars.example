# Copy to .dev.vars for local testing with `npm run dev`. Never commit .dev.vars.
#
# The two Turnstile values below are Cloudflare's official *test* keys. They are
# public, documented, and always pass verification, which is what makes a local
# submit-to-publish rehearsal possible. Replace both with your real widget keys
# before deploying anywhere public.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Any long random string. Salts the IP hash used for submission rate limiting.
SUBMISSION_HASH_SALT=local-development-only-change-me

# Reviewer allowlist — set in wrangler.jsonc vars for production (plain text vars
# are Wrangler-managed on this project). Use your personal admin email, not contact@…
REVIEWER_EMAILS=reviewer@example.com

# Local-only human-verification bypass. A live Turnstile widget (site key 0x...)
# only renders on the hostnames in its dashboard, which never includes localhost,
# so the submit form cannot be exercised locally without this. Requires a loopback
# request host as well as this flag, so it cannot take effect on a deployed site.
# Do NOT set this as a Pages environment variable.
ALLOW_LOCAL_TURNSTILE_BYPASS=true

# Local-only reviewer bypass. Cloudflare Access cannot issue a JWT to a dev
# server, so the review console would be unreachable locally without this. It is
# ignored unless the request host is loopback, so it cannot take effect on a
# deployed site. Do NOT set this as a Pages environment variable.
DEV_REVIEWER_EMAIL=reviewer@example.com

# Production Access settings. Not needed locally; required on the deployed site.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUDIENCE

# Optional solo-admin fallback when Cloudflare Access is not set up yet.
# Set a long random string (16+ chars) as an encrypted Pages secret, then enter
# it once on /review/ to unlock the console. Prefer Access for production.
# ADMIN_REVIEW_SECRET=replace-with-a-long-random-string
